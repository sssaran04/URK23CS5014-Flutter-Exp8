rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lab test mode: only the "employees" collection, until 30 days after setup.
    match /employees/{employeeId} {
      allow read, write: if request.time < timestamp.date(2026, 11, 30);
    }

    // Filled outside the app by tools/seed_books.py; clients can only read.
    match /books/{bookId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
